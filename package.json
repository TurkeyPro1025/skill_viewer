{
  "name": "skills-lingo",
  "version": "1.1.0",
  "description": "A local, read-only skill knowledge base for .agents and 30+ agent skill directories: multi-root scanning, lock-file attribution, and bilingual reading",
  "type": "commonjs",
  "main": "server.js",
  "bin": {
    "skills-lingo": "./server.js"
  },
  "files": [
    "server.js",
    "lib/",
    "public/",
    "seeds/",
    "config.example.json"
  ],
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/api.test.js test/site.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "agent-skills",
    "skill-viewer",
    "skills",
    "claude",
    "translation",
    "i18n",
    "tauri",
    "developer-tools",
    "local-first"
  ]
}
